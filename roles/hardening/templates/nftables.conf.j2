#!/usr/sbin/nft -f
# {{ ansible_managed }}

# Replace only this table. Flushing the whole ruleset would also wipe the tables
# that fail2ban (and other tools) add, silently breaking bans.
table inet filter
delete table inet filter

table inet filter {
  # Per-source SSH rate limit: one noisy scanner cannot lock everyone else out.
  set ssh_meter_v4 {
    type ipv4_addr
    size 65535
    flags dynamic,timeout
    timeout 1m
  }

  set ssh_meter_v6 {
    type ipv6_addr
    size 65535
    flags dynamic,timeout
    timeout 1m
  }

  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

{% if hardening_firewall_allow_icmp | bool %}
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 10/second accept
{% endif %}
    # IPv6 needs ICMPv6 for neighbour discovery.
    meta l4proto ipv6-icmp icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

    tcp dport {{ hardening_ssh_port }} ct state new update @ssh_meter_v4 { ip saddr limit rate {{ hardening_firewall_ssh_rate_limit }} } accept
    tcp dport {{ hardening_ssh_port }} ct state new update @ssh_meter_v6 { ip6 saddr limit rate {{ hardening_firewall_ssh_rate_limit }} } accept
{% if hardening_firewall_allowed_tcp_ports | length > 0 %}
    tcp dport { {{ hardening_firewall_allowed_tcp_ports | join(', ') }} } accept
{% endif %}
{% if hardening_firewall_allowed_udp_ports | length > 0 %}
    udp dport { {{ hardening_firewall_allowed_udp_ports | join(', ') }} } accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
